{
  "version": 2,
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "*" },
      { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-db-uri, x-db-name" },
      { "key": "Access-Control-Allow-Methods", "value": "GET,POST,DELETE,OPTIONS" }
    ]}
  ]
}
